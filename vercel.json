{
  "headers": [
    {
      "source": "/visitbulletin/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/visitbulletin" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/visitbulletin/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/visitbulletin/manifest.json",
      "destination": "/visitbulletin/manifest.json"
    },
    {
      "source": "/visitbulletin/sw.js",
      "destination": "/visitbulletin/sw.js"
    },
    {
      "source": "/visitbulletin/icons/(.*)",
      "destination": "/visitbulletin/icons/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
